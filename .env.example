# A long random string used to sign login sessions. Generate one with:
#   openssl rand -hex 32
# In Coolify, set this under your app's Environment Variables tab, mark it
# secret, and never reuse it elsewhere.
JWT_SECRET=change-this-to-a-long-random-string

# Free API key for the AI Nutritionist's food-to-calories lookup.
# Get one at https://calorieninjas.com/api (no credit card required).
CALORIENINJAS_API_KEY=your-calorieninjas-key-here

# Whichever account signs up (or already exists) with this exact username
# gets access to the Admin tab, everyone else never sees it. Set this to
# the username you'll actually use, then sign up with that same username.
# Leave blank/unset and nobody gets admin access.
ADMIN_USERNAME=your-chosen-admin-username

# Optional: where account/data files are stored inside the container.
# Mount this path as a persistent volume in Coolify so data survives
# redeploys. Defaults to ./data if not set.
# DATA_DIR=/app/data
